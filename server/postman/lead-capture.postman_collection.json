{
  "info": {
    "name": "Lead Capture API",
    "_postman_id": "lead-capture-api-v1",
    "description": "Test suite for the Lead Capture MERN application.\n\nBase URL: http://localhost:5000/api\n\nFeatures tested:\n- Lead submission (happy path)\n- Validation errors (422)\n- Duplicate email (409)\n- Health check",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "ADMIN_SECRET",
      "value": "change_me_in_production",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/health",
              "host": ["{{BASE_URL}}"],
              "path": ["health"]
            },
            "description": "Verify the API server is running."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('success is true', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Lead Submission — Public",
      "item": [
        {
          "name": "POST /leads — ✅ Happy Path",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"budgetRange\": \"1k-5k\",\n  \"message\": \"I need a landing page built for my startup.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BASE_URL}}/leads",
              "host": ["{{BASE_URL}}"],
              "path": ["leads"]
            },
            "description": "Submit a valid lead. Expect 201 Created with the saved document."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('success is true', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.true;",
                  "  pm.expect(body.data).to.have.property('_id');",
                  "  pm.expect(body.data.status).to.equal('New');",
                  "  pm.expect(body.data.email).to.equal('john@example.com');",
                  "  // Save lead ID for later tests",
                  "  pm.collectionVariables.set('leadId', body.data._id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /leads — ❌ Empty Body (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BASE_URL}}/leads",
              "host": ["{{BASE_URL}}"],
              "path": ["leads"]
            },
            "description": "Submit empty body. Expect 422 with field-level error messages."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 422', () => pm.response.to.have.status(422));",
                  "pm.test('Has validation errors array', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.false;",
                  "  pm.expect(body.errors).to.be.an('array').with.length.greaterThan(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /leads — ❌ Invalid Email (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"J\",\n  \"email\": \"not-an-email\",\n  \"budgetRange\": \"maybe\",\n  \"message\": \"hi\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BASE_URL}}/leads",
              "host": ["{{BASE_URL}}"],
              "path": ["leads"]
            },
            "description": "Submit with invalid email, bad budgetRange enum, name too short, message too short. Expect 422 with multiple errors."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 422', () => pm.response.to.have.status(422));",
                  "pm.test('Multiple field errors returned', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.errors.length).to.be.greaterThan(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /leads — ❌ Duplicate Email (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe Again\",\n  \"email\": \"john@example.com\",\n  \"budgetRange\": \"5k-10k\",\n  \"message\": \"Submitting the same email a second time.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BASE_URL}}/leads",
              "host": ["{{BASE_URL}}"],
              "path": ["leads"]
            },
            "description": "Submit the same email that was used in the Happy Path test. Expect 409 Conflict."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('Duplicate key message', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.false;",
                  "  pm.expect(body.message).to.include('email');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /leads — ❌ Missing Message (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Smith\",\n  \"email\": \"jane@example.com\",\n  \"budgetRange\": \">10k\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BASE_URL}}/leads",
              "host": ["{{BASE_URL}}"],
              "path": ["leads"]
            },
            "description": "Submit without the message field. Expect 422 with a message error."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 422', () => pm.response.to.have.status(422));",
                  "pm.test('Message field error present', () => {",
                  "  const body = pm.response.json();",
                  "  const fields = body.errors.map(e => e.field);",
                  "  pm.expect(fields).to.include('message');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /leads — ❌ Invalid Budget Range (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Brown\",\n  \"email\": \"alice@example.com\",\n  \"budgetRange\": \"tons of money\",\n  \"message\": \"This budget range is not in the allowed list.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BASE_URL}}/leads",
              "host": ["{{BASE_URL}}"],
              "path": ["leads"]
            },
            "description": "Submit with a budgetRange not in the enum. Expect 422."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 422', () => pm.response.to.have.status(422));",
                  "pm.test('budgetRange field error present', () => {",
                  "  const body = pm.response.json();",
                  "  const fields = body.errors.map(e => e.field);",
                  "  pm.expect(fields).to.include('budgetRange');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /leads — ✅ Second Valid Lead",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Smith\",\n  \"email\": \"jane@example.com\",\n  \"budgetRange\": \">10k\",\n  \"message\": \"Looking for a full e-commerce platform with custom integrations.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BASE_URL}}/leads",
              "host": ["{{BASE_URL}}"],
              "path": ["leads"]
            },
            "description": "Add a second lead so admin tests have data to work with."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Lead created with status New', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.status).to.equal('New');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin API — Protected",
      "item": [
        {
          "name": "GET /admin/leads — ✅ All Leads",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-admin-secret", "value": "{{ADMIN_SECRET}}" }],
            "url": { "raw": "{{BASE_URL}}/admin/leads", "host": ["{{BASE_URL}}"], "path": ["admin", "leads"] },
            "description": "Fetch all leads. Expect 200 with leads array and pagination metadata."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "pm.test('Has leads array and pagination', () => {",
            "  const { data } = pm.response.json();",
            "  pm.expect(data.leads).to.be.an('array');",
            "  pm.expect(data.pagination).to.have.property('total');",
            "  if (data.leads.length > 0) pm.collectionVariables.set('leadId', data.leads[0]._id);",
            "});"
          ]}}]
        },
        {
          "name": "GET /admin/leads?search=john — ✅ Search",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-admin-secret", "value": "{{ADMIN_SECRET}}" }],
            "url": {
              "raw": "{{BASE_URL}}/admin/leads?search=john",
              "host": ["{{BASE_URL}}"], "path": ["admin", "leads"],
              "query": [{ "key": "search", "value": "john" }]
            },
            "description": "Search leads by name or email. Expect results containing 'john'."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "pm.test('Results match search term', () => {",
            "  const { data } = pm.response.json();",
            "  data.leads.forEach(lead => {",
            "    const matches = lead.name.toLowerCase().includes('john') || lead.email.toLowerCase().includes('john');",
            "    pm.expect(matches).to.be.true;",
            "  });",
            "});"
          ]}}]
        },
        {
          "name": "GET /admin/leads — ❌ No Secret (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{BASE_URL}}/admin/leads", "host": ["{{BASE_URL}}"], "path": ["admin", "leads"] },
            "description": "Request without x-admin-secret header. Expect 401 Unauthorized."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 401', () => pm.response.to.have.status(401));",
            "pm.test('Unauthorized message', () => {",
            "  pm.expect(pm.response.json().success).to.be.false;",
            "});"
          ]}}]
        },
        {
          "name": "PATCH /admin/leads/:id/status — ✅ Update to Contacted",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "x-admin-secret", "value": "{{ADMIN_SECRET}}" },
              { "key": "Content-Type",   "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"status\": \"Contacted\"}", "options": { "raw": { "language": "json" }}},
            "url": {
              "raw": "{{BASE_URL}}/admin/leads/{{leadId}}/status",
              "host": ["{{BASE_URL}}"], "path": ["admin", "leads", "{{leadId}}", "status"]
            },
            "description": "Update the lead saved in leadId variable to Contacted. Run after GET all leads."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "pm.test('Lead status is Contacted', () => {",
            "  pm.expect(pm.response.json().data.status).to.equal('Contacted');",
            "});"
          ]}}]
        },
        {
          "name": "PATCH /admin/leads/:id/status — ❌ Invalid Status (422)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "x-admin-secret", "value": "{{ADMIN_SECRET}}" },
              { "key": "Content-Type",   "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"status\": \"Pending\"}", "options": { "raw": { "language": "json" }}},
            "url": {
              "raw": "{{BASE_URL}}/admin/leads/{{leadId}}/status",
              "host": ["{{BASE_URL}}"], "path": ["admin", "leads", "{{leadId}}", "status"]
            },
            "description": "Try to set an invalid status value. Expect 422 validation error."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 422', () => pm.response.to.have.status(422));",
            "pm.test('status field error present', () => {",
            "  const fields = pm.response.json().errors.map(e => e.field);",
            "  pm.expect(fields).to.include('status');",
            "});"
          ]}}]
        }
      ]
    }
  ]
}
